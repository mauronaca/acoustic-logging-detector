	(text "ESQUEMA 2/2 - ELECTRONICO CONCEPTUAL (equivalente interno de cada modulo)"
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "3a5269b7-8de1-4c5a-9a58-7085cf978737")
	)
	(text "[1] PANEL + CARGADOR: PMOS anti-inversion + CN3065 lineal CC/CV (ISET 2k = 900 mA max).\nEficiencia lineal ~ Vbat/Vpanel (DFRobot: 73 % a 3.7 V / 900 mA). No es MPPT."
		(exclude_from_sim no)
		(at 20 30 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "3f49ce10-b3bf-461f-8aae-6c67f8c0e532")
	)
	(text "[2] MEDICION: shunt 0.1 ohm en BAT+ (lado alto), leido por el INA219 (IN+ / IN-).\nCorriente positiva = CARGA, negativa = DESCARGA.\nDW06D: FET serie en el negativo (corte 2.4 V / 4.3 V / 3 A)."
		(exclude_from_sim no)
		(at 150 130 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "e3bcaca1-9a54-4255-9c22-9e1be09c7481")
	)
	(text "[3] BOOST 5 V (MT3608): Vout = 0.6 x (1 + Rb/Rc) = 5.1 V. SY6280 limita a 1.1 A.\nEl nodo cuelga de VBAT_CHG: i_bat = i_cargador - i_carga."
		(exclude_from_sim no)
		(at 20 150 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "7100c28b-3e1d-4482-ae6c-900003b1b334")
	)
	(text "[4] ESP32-S3 = carga del 5 V. Divisor 200k/100k (3:1) a GPIO4 + 100 nF."
		(exclude_from_sim no)
		(at 270 215 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "b31556d1-4305-4503-97b3-d86439a076b8")
	)
